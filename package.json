{
  "name": "frameworkorpokemon",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "db:setup": "bun scripts/setup-local-db.ts",
    "test:db": "bun test src/db/database.test.ts",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun --bun run .output/server/index.mjs",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test:e2e:run": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:report": "bunx playwright show-report",
    "test:codegen": "bunx playwright codegen http://localhost:3000"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.64.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/router-cli": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.55.0",
    "nitro": "npm:nitro-nightly@^3.0.1-20261008-023340-cef53050",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {},
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.4.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
